{
  "name": "bff",
  "root": "apps/bff",
  "sourceRoot": "apps/bff/src",
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/bff",
        "main": "apps/bff/src/main.ts",
        "tsConfig": "apps/bff/tsconfig.json"
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "bff:build"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/bff"],
      "options": {
        "jestConfig": "apps/bff/jest.config.js"
      }
    }
  }
}

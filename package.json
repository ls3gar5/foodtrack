{
  "name": "foodtrack",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "modules/*"
  ],
  "scripts": {
    "dev": "npx nx run-many --target=serve --all",
    "build": "npx nx run-many --target=build --all",
    "lint": "npx nx run-many --target=lint --all",
    "test": "npx nx run-many --target=test --all",
    "test:unit": "npx nx run-many --target=test --all",
    "test:e2e": "npx nx run-many --target=test:e2e --all",
    "test:coverage": "npx nx run-many --target=test --all -- --coverage"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.18.1",
    "bullmq": "^5.79.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.11.1",
    "leaflet": "^1.9.4",
    "pg": "^8.13.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^7.18.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/jest": "^21.0.0",
    "@nx/js": "^21.0.0",
    "@nx/webpack": "^21.0.0",
    "@swc/core": "^1.7.0",
    "@swc/jest": "^0.2.37",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^29.5.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "fast-check": "^4.8.0",
    "jest": "^29.7.0",
    "nx": "^21.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.0"
  }
}
